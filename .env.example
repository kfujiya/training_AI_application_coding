# PostgreSQL専用インスタンス（5434番以外へ変更しない）
DB_URL=jdbc:postgresql://127.0.0.1:5434/weather_db
DB_USERNAME=weather_app
DB_PASSWORD=change-me-locally

# Open-Meteo公開エンドポイント（APIキー不要）
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com

# Spring Boot
SERVER_PORT=8080
